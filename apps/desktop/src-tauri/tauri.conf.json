{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Voice Studio",
  "version": "0.1.0",
  "identifier": "org.voicestudio.desktop",
  "build": {
    "frontendDist": "../dist",
    "beforeDevCommand": "pnpm --filter voice-studio-desktop dev",
    "beforeBuildCommand": "pnpm --filter voice-studio-desktop build",
    "devUrl": "http://localhost:1420"
  },
  "app": {
    "windows": [
      {
        "title": "Voice Studio",
        "width": 1360,
        "height": 860,
        "minWidth": 1080,
        "minHeight": 700,
        "center": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/**", "$EXE/../app-data/**", "**/app-data/cache/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico", "icons/32x32.png", "icons/128x128.png"],
    "resources": [],
    "windows": {
      "nsis": {
        "installMode": "perMachine"
      }
    }
  }
}
